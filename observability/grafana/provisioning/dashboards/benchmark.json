{
  "annotations": {"list": []},
  "editable": true,
  "links": [
    {
      "title": "Producers / consumers: each and total",
      "type": "link",
      "url": "/d/scenario-clients",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (broker, scenario_id) (rate(benchmark_producer_messages_accepted_total{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{broker}} {{scenario_id}}", "refId": "A"}],
      "title": "Producer accepted RPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (broker, scenario_id) (rate(benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{broker}} {{scenario_id}}", "refId": "A"}],
      "title": "Consumer received RPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, broker, scenario_id) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"$scenario_id\"}[1m])))", "legendFormat": "p50 {{broker}} {{scenario_id}}", "refId": "A"},
        {"expr": "histogram_quantile(0.75, sum by (le, broker, scenario_id) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"$scenario_id\"}[1m])))", "legendFormat": "p75 {{broker}} {{scenario_id}}", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (le, broker, scenario_id) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"$scenario_id\"}[1m])))", "legendFormat": "p95 {{broker}} {{scenario_id}}", "refId": "C"},
        {"expr": "histogram_quantile(0.99, sum by (le, broker, scenario_id) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"$scenario_id\"}[1m])))", "legendFormat": "p99 {{broker}} {{scenario_id}}", "refId": "D"}
      ],
      "title": "Consumer latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 4,
      "targets": [{"expr": "sum by (broker, scenario_id) (benchmark_producer_in_flight{scenario_id=~\"$scenario_id\"})", "legendFormat": "{{broker}} {{scenario_id}}", "refId": "A"}],
      "title": "Producer in-flight operations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "id": 5,
      "targets": [{"expr": "sum by (component) (rate(benchmark_container_cpu_seconds{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{component}}", "refId": "A"}],
      "title": "Scenario containers: CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 6,
      "targets": [{"expr": "sum by (component) (benchmark_container_memory_bytes{scenario_id=~\"$scenario_id\"})", "legendFormat": "{{component}}", "refId": "A"}],
      "title": "Scenario containers: memory working set",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "id": 7,
      "targets": [
        {"expr": "sum by (component) (rate(benchmark_container_network_received_bytes{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{component}} rx", "refId": "A"},
        {"expr": "sum by (component) (rate(benchmark_container_network_transmitted_bytes{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{component}} tx", "refId": "B"}
      ],
      "title": "Scenario containers: network throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "id": 8,
      "targets": [{"expr": "sum by (component) (rate(benchmark_container_disk_written_bytes{scenario_id=~\"$scenario_id\"}[1m]))", "legendFormat": "{{component}}", "refId": "A"}],
      "title": "Scenario containers: disk write throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 9,
      "targets": [{"expr": "sum by (broker, scenario_id) (benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\"})", "legendFormat": "{{broker}} {{scenario_id}}", "refId": "A"}],
      "title": "Consumer messages received total",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 10,
      "targets": [
        {"expr": "sum by (broker, scenario_id) (benchmark_producer_messages_accepted_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})", "legendFormat": "sent {{broker}} {{scenario_id}}", "refId": "A"},
        {"expr": "sum by (broker, scenario_id) (benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})", "legendFormat": "received {{broker}} {{scenario_id}}", "refId": "B"},
        {"expr": "sum by (broker, scenario_id) (benchmark_consumer_duplicate_messages_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})", "legendFormat": "duplicates {{broker}} {{scenario_id}}", "refId": "C"},
        {"expr": "clamp_min(sum by (broker, scenario_id) (benchmark_producer_messages_accepted_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"}) - (sum by (broker, scenario_id) (benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"}) - sum by (broker, scenario_id) (benchmark_consumer_duplicate_messages_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})), 0)", "legendFormat": "lost {{broker}} {{scenario_id}}", "refId": "D"}
      ],
      "title": "Delivery reliability counts",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 11,
      "targets": [
        {"expr": "100 * clamp_min(sum by (broker, scenario_id) (benchmark_producer_messages_accepted_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"}) - (sum by (broker, scenario_id) (benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"}) - sum by (broker, scenario_id) (benchmark_consumer_duplicate_messages_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})), 0) / sum by (broker, scenario_id) (benchmark_producer_messages_accepted_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})", "legendFormat": "lost {{broker}} {{scenario_id}}", "refId": "A"},
        {"expr": "100 * sum by (broker, scenario_id) (benchmark_consumer_duplicate_messages_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"}) / sum by (broker, scenario_id) (benchmark_consumer_messages_received_total{scenario_id=~\"$scenario_id\",phase=\"measurement\"})", "legendFormat": "duplicates {{broker}} {{scenario_id}}", "refId": "B"}
      ],
      "title": "Delivery reliability ratios",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["benchmark"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(benchmark_consumer_messages_received_total, scenario_id)",
        "includeAll": true,
        "multi": false,
        "name": "scenario_id",
        "query": "label_values(benchmark_consumer_messages_received_total, scenario_id)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "title": "Message broker benchmark",
  "uid": "broker-benchmark",
  "version": 5
}
