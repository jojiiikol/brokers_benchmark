      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (scenario_id, instance) (rate(benchmark_producer_messages_accepted_total{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\",phase=\"measurement\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Accepted messages per second by producer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (scenario_id, instance) (rate(benchmark_consumer_messages_received_total{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\",phase=\"measurement\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Received messages per second by consumer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (scenario_id, instance) (benchmark_producer_in_flight{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"})", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "In-flight operations by producer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (scenario_id, instance) (benchmark_consumer_messages_received_total{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\",phase=\"measurement\"})", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Total received messages by consumer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
