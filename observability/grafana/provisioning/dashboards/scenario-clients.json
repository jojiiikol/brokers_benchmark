{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Producer RPS: each and sum",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Individual selected containers and their sum. TOTAL includes only containers selected above; scenarios are never added together. Measurement phase only.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario_id, instance) (rate(benchmark_producer_messages_accepted_total{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "{{scenario_id}} / {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (scenario_id) (rate(benchmark_producer_messages_accepted_total{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "TOTAL selected / {{scenario_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(TOTAL|COMBINED) selected /"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
