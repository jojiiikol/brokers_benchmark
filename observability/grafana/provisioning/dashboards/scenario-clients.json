    {
      "id": 8,
      "title": "Consumer latency P50: each and combined",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "COMBINED is calculated from all selected consumers together, separately per scenario. Consumer percentiles are never summed or averaged. Latency is sampled from measurement messages; the graph uses the rate interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, scenario_id, instance) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval])))",
