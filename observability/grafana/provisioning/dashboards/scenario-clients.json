      "id": 7,
      "targets": [{"expr": "sum by (scenario_id, container_name) (rate(benchmark_container_cpu_seconds{scenario_id=~\"${scenario_id:regex}\",container_name=~\"${container:regex}\",component=~\"producer|consumer\"}[$__rate_interval]))", "legendFormat": "{{container_name}}", "refId": "A"}],
      "title": "CPU usage by client container",
      "type": "timeseries"
