      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, scenario_id, instance) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Delivery latency P95 by consumer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le, scenario_id, instance) (rate(benchmark_consumer_latency_seconds_bucket{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Delivery latency P99 by consumer",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
