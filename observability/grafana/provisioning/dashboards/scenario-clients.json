    {
      "id": 7,
      "title": "Consumer mean latency: each and combined",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "COMBINED is the sample-weighted mean (sum of latency / number of samples), not the mean of consumer means. Calculated over the rate interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario_id, instance) (rate(benchmark_consumer_latency_seconds_sum{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval])) / sum by (scenario_id, instance) (rate(benchmark_consumer_latency_seconds_count{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{scenario_id}} / {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (scenario_id) (rate(benchmark_consumer_latency_seconds_sum{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval])) / sum by (scenario_id) (rate(benchmark_consumer_latency_seconds_count{scenario_id=~\"${scenario_id:regex}\",instance=~\"${container:regex}\"}[$__rate_interval]))",
          "legendFormat": "COMBINED selected / {{scenario_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(TOTAL|COMBINED) selected /"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
