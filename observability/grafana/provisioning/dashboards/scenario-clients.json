    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 8,
      "targets": [{"expr": "sum by (scenario_id, container_name) (benchmark_container_memory_bytes{scenario_id=~\"${scenario_id:regex}\",container_name=~\"${container:regex}\",component=~\"producer|consumer\"})", "legendFormat": "{{container_name}}", "refId": "A"}],
      "title": "Memory usage by client container",
      "type": "timeseries"
